def write_active(active: dict):
    dest = active_path()
    try:
        tmp = dest.with_suffix(".tmp")
        tmp.write_text(json.dumps({"source": active.get("source"),
                                   "player": active.get("player")}))
        os.replace(tmp, dest)
    except OSError:
        pass


def read_active():
