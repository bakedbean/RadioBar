// Add "custom/radio" to one of the modules arrays in ~/.config/waybar/config.jsonc.
// The END of "modules-left" is the best spot: its free edge faces the empty
// center, so the scrolling title can never be nudged by (or nudge) other
// modules. Then paste this block among the module definitions:
"custom/radio": {
  "exec": "radiobar status",
  "return-type": "json",
  "on-click": "radiobar click",
  "on-click-middle": "radiobar prev",
  "on-click-right": "radiobar menu",
  "tooltip": true
}

// Optional: album-art thumbnail. Add "image#radioart" to the same modules
// array, right before "custom/radio". Keep "size" a few px under the bar
// "height" so the art doesn't touch the bar edges:
"image#radioart": {
  "path": "/run/user/1000/radiobar-art.jpg",
  "size": 20,
  "signal": 6,
  // "once" is load-bearing, do NOT omit it: waybar 0.15.0 clamps a missing
  // interval to 1ms, so the module would reload the jpg 1000x/s — ~50% CPU
  // and enough dispatcher traffic to trigger waybar's freeze deadlock.
  // RadioBar's RTMIN+6 signal still refreshes the art on track changes.
  "interval": "once",
  "tooltip": false
}
// (Adjust /run/user/1000 if your UID differs — echo $XDG_RUNTIME_DIR.)
